{
	"name": "n-region-viewer",
	"icon": "images/icon.png",
	"publisher": "Leon",
	"displayName": "nRegion Viewer",
	"description": "This extension allows you to print a list of regions in a document and select a region to navigate to the document's location.",
	"version": "0.2.0",
	"engines": {
		"vscode": "^1.44.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/berabue/vscode-region-viewer.git"
	},
	"bugs": {
		"url": "https://github.com/berabue/vscode-region-viewer/issues",
		"email": "berabue@gmail.com"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"contributes": {
		"configuration": [
			{
				"title": "Region Viewer",
				"properties": {
					"region-viewer.followCursor": {
						"type": "boolean",
						"default": true,
						"description": "Automatically reveal the region at the cursor position"
					},
					"region-viewer.showDecorations": {
						"type": "boolean",
						"default": true,
						"description": "Show decorations on region marker lines"
					},
					"region-viewer": {
						"type": "object",
						"scope": "application",
						"description": "Override region markers for specific languages and customize colors",
						"properties": {
							"colors": {
								"type": "object",
								"description": "Customize marker colors",
								"properties": {
									"foreground": {
										"type": "string",
										"description": "Foreground color for region marker lines (CSS color)"
									},
									"background": {
										"type": "string",
										"description": "Background color for region marker lines (CSS color)"
									}
								}
							}
						}
					}
				}
			}
		],
		"views": {
			"explorer": [
				{
					"id": "regionViewer",
					"name": "Region Viewer",
					"icon": "./images/hashtag.svg",
					"contextualTitle": "Region Viewer"
				}
			]
		},
		"commands": [
			{
				"command": "region-viewer.activeDocumentLanguageId",
				"title": "Active Document Language ID",
				"category": "Region Viewer",
				"icon": "$(extensions-info-message)"
			},
			{
				"command": "region-viewer.followCursor.on",
				"title": "✓ Follow Cursor",
				"category": "Region Viewer"
			},
			{
				"command": "region-viewer.followCursor.off",
				"title": "  Follow Cursor",
				"category": "Region Viewer"
			},
			{
				"command": "region-viewer.showDecorations.on",
				"title": "✓ Show Decorations",
				"category": "Region Viewer"
			},
			{
				"command": "region-viewer.showDecorations.off",
				"title": "  Show Decorations",
				"category": "Region Viewer"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "region-viewer.followCursor.on",
					"when": "view == regionViewer && regionViewer.followCursor",
					"group": "1_config@1"
				},
				{
					"command": "region-viewer.followCursor.off",
					"when": "view == regionViewer && !regionViewer.followCursor",
					"group": "1_config@1"
				},
				{
					"command": "region-viewer.showDecorations.on",
					"when": "view == regionViewer && regionViewer.showDecorations",
					"group": "1_config@2"
				},
				{
					"command": "region-viewer.showDecorations.off",
					"when": "view == regionViewer && !regionViewer.showDecorations",
					"group": "1_config@2"
				},
				{
					"command": "region-viewer.activeDocumentLanguageId",
					"when": "view == regionViewer",
					"group": "navigation"
				}
			],
			"commandPalette": [
				{ "command": "region-viewer.followCursor.on", "when": "false" },
				{ "command": "region-viewer.followCursor.off", "when": "false" },
				{ "command": "region-viewer.showDecorations.on", "when": "false" },
				{ "command": "region-viewer.showDecorations.off", "when": "false" }
			]
		}
	},
	"scripts": {
		"vscode:prepublish": "tsc",
		"compile": "tsc -p ./",
		"lint": "eslint src --ext ts",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"test": "node ./out/test/runTest.js"
	},
	"devDependencies": {
		"@types/vscode": "^1.44.0",
		"@types/glob": "^7.1.1",
		"@types/mocha": "^7.0.2",
		"@types/node": "^25.6.0",
		"eslint": "^10.2.0",
		"@typescript-eslint/parser": "^8.58.1",
		"@typescript-eslint/eslint-plugin": "^8.58.1",
		"glob": "^7.1.6",
		"mocha": "^11.3.0",
		"typescript": "^6.0.2",
		"vscode-test": "^1.3.0"
	},
	"overrides": {
		"diff": ">=8.0.3",
		"serialize-javascript": ">=7.0.5"
	}
}
